rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == "topique01@gmail.com";
    }

    // ===== DAFTAR EMAIL YANG BOLEH MELIHAT DATA PRIBADI =====
    // Tambah / hapus email di sini (huruf kecil semua), lalu klik Publish di Firebase Console.
    // Yang boleh mengubah data tetap hanya owner (isOwner).
    function isViewer() {
      return isSignedIn()
        && request.auth.token.email in [
          "topique01@gmail.com"
          // , "teman@gmail.com"
        ];
    }

    // ===== DATA PRIBADI: baca = daftar email di atas, tulis = owner =====
    match /finances/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    match /journalCategories/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    match /journals/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    match /budgets/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    match /assets/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    match /reminders/{docId} {
      allow read: if isViewer();
      allow write: if isOwner();
    }

    // Dipakai aplikasi untuk mengecek apakah akun boleh melihat data pribadi (dokumen tidak perlu dibuat)
    match /access/{docId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ===== TABUNGAN BERSAMA ORANG HAVE: baca = siapa pun (tanpa login), tulis = owner =====
    match /ohMembers/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /ohPayments/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /ohKasExpenses/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /ohLoans/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
